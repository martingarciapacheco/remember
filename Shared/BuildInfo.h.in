#pragma once

#define REMEMBER_VERSION "@REMEMBER_VERSION@"
#define REMEMBER_GIT_HASH "@REMEMBER_GIT_HASH@"
#define REMEMBER_GIT_COMMIT "@REMEMBER_GIT_COMMIT@"
#define REMEMBER_SOURCE_STATE "@REMEMBER_SOURCE_STATE@"
#define REMEMBER_BUILD_ID "@REMEMBER_BUILD_ID@"
#define REMEMBER_SOURCE_FINGERPRINT "@REMEMBER_SOURCE_FINGERPRINT@"
