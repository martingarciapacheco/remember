# Opt-in memory instrumentation. Use a separate build directory; ordinary
# Release artifacts never depend on a sanitizer runtime.
option(REMEMBER_ENABLE_ASAN "Instrument Remember and its tests with AddressSanitizer" OFF)
if(REMEMBER_ENABLE_ASAN)
    if(MSVC)
        # /RTC and edit-and-continue are incompatible with MSVC ASan.
        foreach(flag CMAKE_C_FLAGS_DEBUG CMAKE_CXX_FLAGS_DEBUG)
            string(REGEX REPLACE "/RTC[1su]+" "" ${flag} "${${flag}}")
            string(REPLACE "/ZI" "/Zi" ${flag} "${${flag}}")
        endforeach()
        add_compile_options(/fsanitize=address /Zi)
        add_link_options(/DEBUG /INCREMENTAL:NO)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        add_compile_options(-fsanitize=address -fno-omit-frame-pointer -g)
        add_link_options(-fsanitize=address)
    else()
        message(FATAL_ERROR "REMEMBER_ENABLE_ASAN is unsupported by this compiler")
    endif()
endif()

function(remember_copy_asan_runtime target)
    if(REMEMBER_ENABLE_ASAN AND MSVC)
        get_filename_component(compiler_directory "${CMAKE_CXX_COMPILER}" DIRECTORY)
        if(CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "ARM64")
            set(asan_arch aarch64)
        elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
            set(asan_arch x86_64)
        else()
            set(asan_arch i386)
        endif()
        set(asan_runtime "${compiler_directory}/clang_rt.asan_dynamic-${asan_arch}.dll")
        if(NOT EXISTS "${asan_runtime}")
            message(FATAL_ERROR "MSVC AddressSanitizer runtime is missing: ${asan_runtime}")
        endif()
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "${asan_runtime}" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
    endif()
endfunction()
